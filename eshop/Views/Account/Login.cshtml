@model eshop.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-box">
    <h2>Login</h2>
    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="auth-error"></div>

        <input asp-for="Email" placeholder="Email" />
        <span asp-validation-for="Email" class="auth-error"></span>

        <input asp-for="Password" placeholder="Password" />
        <span asp-validation-for="Password" class="auth-error"></span>

        <label><input asp-for="RememberMe" type="checkbox" /> Remember me</label>

        <button type="submit">Login</button>
    </form>
    <p>New user? <a asp-action="Register">Create an account</a></p>
</div>