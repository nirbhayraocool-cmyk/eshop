@model List<eshop.Models.Order>
@{
    ViewData["Title"] = "Admin - Orders";
    var images = ViewBag.Images as Dictionary<int, string>;
}

<div class="admin-wrap">
    <div class="admin-head">
        <h2>📦 Orders</h2>
        <a asp-action="Index" class="admin-edit">← Products</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background:#d4edda;color:#155724;padding:10px;margin-bottom:15px;">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <p>No order has been received yet.</p>
    }

    @foreach (var order in Model)
    {
        <div class="order-card">
            <div class="order-head">
                <div>
                    <strong>Order #@order.Id</strong><br />
                    <small>@order.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</small>
                </div>
                <span class="order-status">@order.Status</span>
            </div>

            <table class="cart-table">
                <thead>
                    <tr><th>Product</th><th>Price</th><th>Qty</th><th>Total</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>
                                @if (images != null && images.TryGetValue(item.ProductId, out var img))
                                {
                                    <img src="@img" alt="@item.ProductName"
                                         style="width:50px;height:50px;object-fit:cover;border-radius:6px;vertical-align:middle;margin-right:8px;" />
                                }
                                @item.ProductName
                                @if (!string.IsNullOrEmpty(item.Size))
                                {
                                    <br />
                        
                                    <small>Size: @item.Size</small>
                                }
                            </td>
                            <td>₹@item.Price.ToString("N0")</td>
                            <td>@item.Quantity</td>
                            <td>₹@((item.Price * item.Quantity).ToString("N0"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="order-foot">
                <div>
                    <small>Customer:</small><br />
                    @order.CustomerName, @order.Phone<br />
                    @order.Address
                </div>
                <h3>Total: ₹@order.TotalAmount.ToString("N0")</h3>
            </div>

            <form asp-action="UpdateOrderStatus" method="post" class="status-form">
                <input type="hidden" name="id" value="@order.Id" />
                <select name="status">
                    @foreach (var s in new[] { "Pending", "Confirmed", "Shipped", "Delivered", "Cancelled" })
                    {
                        <option value="@s" selected="@(s == order.Status)">@s</option>
                    }
                </select>
                <button type="submit" class="admin-save">Update Status</button>
            </form>
        </div>
    }
</div>