@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@inject eshop.Data.AppDbContext Db
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@{
    var currentUserId = UserManager.GetUserId(User);
    var cartCount = currentUserId == null
        ? 0
        : await Db.CartItems.Where(x => x.UserId == currentUserId).SumAsync(x => x.Quantity);

    var isAdmin = User.IsInRole("Admin");

    var pendingOrders = isAdmin
        ? await Db.Orders.CountAsync(o => o.Status == "Pending")
        : 0;

    var unreadMessages = isAdmin
        ? await Db.ContactMessages.CountAsync(m => !m.IsRead)
        : 0;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eshop</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="~/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>

    <!-- ================= Top Bar ================= -->
    <div class="top-bar">
        <div class="top-left">
            <span>
                <a href="tel:+918874196809" style="text-decoration:none;color:white">
                    <i class="fa-solid fa-phone"></i> +91 8874196809
                </a>
            </span>

            <span>
                <a href="mailto:nirbhayraocool@nextcart.com" style="text-decoration:none;color:white">
                    <i class="fa-solid fa-envelope"></i> support@nextcart.com
                </a>
            </span>
        </div>

        <div class="top-center">
            🚚 Free Shipping On Orders Above ₹999
        </div>

        <div class="top-right">
            <a href="#">Track Order</a>
            @if (SignInManager.IsSignedIn(User))
            {
                <span>Hi, @User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    <button type="submit" style="background:none;border:none;color:inherit;cursor:pointer">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Login</a>
                <a asp-controller="Account" asp-action="Register">Register</a>
            }
            <select>
                <option>English</option>
                <option>Hindi</option>
            </select>
        </div>
    </div>

    <!-- ================= Header ================= -->
    <header>
        <div class="logo">
            <h2>Next<span>Cart</span></h2>
        </div>

        <form asp-controller="Home" asp-action="Search" method="get" class="search-box">
            <input type="text" name="q" placeholder="Search for Products..." value="@Context.Request.Query["q"]" />
            <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>

        <div class="icons">
            <div class="icon"><i class="fa-regular fa-heart"></i></div>
            <a asp-controller="Home" asp-action="Cart" class="icon cart" style="text-decoration:none; color:inherit;">
                <i class="fa-solid fa-cart-shopping"></i>
                <span class="badge" id="cartBadge">@cartCount</span>
            </a>
            @if (SignInManager.IsSignedIn(User))
            {
                <div class="icon user-menu">
                    <i class="fa-solid fa-user"></i>
                    <div class="user-dropdown">
                        <span class="user-name">@User.Identity?.Name</span>
                        <a asp-controller="Home" asp-action="Cart">My Cart</a>
                        <a asp-controller="Order" asp-action="MyOrders">My Orders</a>
                        <a asp-controller="Admin" asp-action="Messages">
                            ✉️ Messages
                            @if (unreadMessages > 0)
                            {
                                <span class="pending-badge">@unreadMessages</span>
                            }
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Admin" asp-action="Index">Admin Panel</a>
                        }
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit">Logout</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="icon" style="text-decoration:none; color:inherit;" title="Login">
                    <i class="fa-regular fa-user"></i>
                </a>
            }
        </div>
    </header>

    <!-- ================= Navbar ================= -->
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <div class="nav-logo">
                <a href="#home" class="logo-link">
                    <span class="logo-icon"><i class="fa-solid fa-cart-shopping"></i></span>
                    <span class="logo-text">Next<span>Cart</span></span>
                </a>
            </div>

            <ul class="nav-menu" id="navMenu">
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="home">Home</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="newarrival">Shop</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="category">Categories</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="newarrival">New Arrival</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="featured">Deals</a></li>
                <li><a asp-controller="Home" asp-action="Index" asp-fragment="Cta-footer">Brands</a></li>
                <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
            </ul>

            <div class="hamburger" id="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- ================= Render Body ================= -->
    <div class="container-fluid">
        @RenderBody()
    </div>

    <!-- ================= Footer ================= -->
    <footer class="footer" id="footer">
        <div class="footer-container">
            <div class="footer-col">
                <h2 class="footer-logo">Next<span>Cart</span></h2>
                <p>NextCart is your trusted online shopping destination for fashion, electronics, home essentials and more.</p>
                <div class="social-icons">
                    <a href="https://www.facebook.com/" target="_black"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="https://www.instagram.com/" target="_blank"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://x.com/" target="_blank"><i class="fa-brands fa-x-twitter"></i></a>
                    <a href="https://www.linkedin.com/" target="_blank"><i class="fa-brands fa-linkedin-in"></i></a>
                </div>
            </div>

            <div class="footer-col">
                <h3>Quick Links</h3>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="home">Home</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="newarrival">Shop</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="category">Categories</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="newarrival">Offers</a></li>
                    <li><a asp-action="Contact" >Contact</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Categories</h3>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="newarrival">Fashion</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="newarrival">Electronics</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="featured">Shoes</a></li>
                    <li><a asp-controller="Home" asp-action="Index" asp-fragment="category">Beauty</a></li>
                    <li><a href="#">Accessories</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Customer Care</h3>
                <ul>
                    <li><a asp-controller="Account" asp-action="Login">My Account</a></li>
                    <li><a href="#">Track Order</a></li>
                    <li><a href="#">Return Policy</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms & Conditions</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>Contact Us</h3>
                <p><i class="fa-solid fa-location-dot"></i> Lucknow, Uttar Pradesh</p>
                <p>
                    <a href="tel:+918874196809" style="text-decoration:none;color:white">
                        <i class="fa-solid fa-phone"></i> +91 8874196809
                    </a>
                </p>
                <p>
                    <a href="mailto:nirbhayraocool@nextcart.com" style="text-decoration:none;color:white">
                        <i class="fa-solid fa-envelope"></i> support@nextcart.com
                    </a>
                </p>
            </div>
        </div>

        <hr>

        <div class="copyright">
            <p>© 2026 NextCart. All Rights Reserved. Designed by Nirbhay.</p>
        </div>
    </footer>

    <script>
        /* ============================================
           NAVBAR / HAMBURGER / SCROLL
           ============================================ */
        const navbar    = document.getElementById('navbar');
        const hamburger = document.getElementById('hamburger');
        const navMenu   = document.getElementById('navMenu');

        /* 1. Scroll Effect */
        let isScrolled = false;
        window.addEventListener('scroll', () => {
            const y = window.scrollY;

            if (y > 80 && !isScrolled) {
                navbar.classList.add('scrolled');
                isScrolled = true;
            } else if (y <= 80 && isScrolled) {
                navbar.classList.remove('scrolled');
                isScrolled = false;
            }

            if (y > 300) navbar.classList.add('dark');
            else         navbar.classList.remove('dark');
        });

        /* 2. Hamburger Toggle */
        hamburger.addEventListener('click', function (e) {
            e.stopPropagation();
            this.classList.toggle('active');
            navMenu.classList.toggle('active');
            document.body.style.overflow = navMenu.classList.contains('active') ? 'hidden' : '';
        });

        /* 3. Close on link click */
        document.querySelectorAll('.nav-menu a').forEach(link => {
            link.addEventListener('click', () => {
                hamburger.classList.remove('active');
                navMenu.classList.remove('active');
                document.body.style.overflow = '';
            });
        });

        /* 4. Close on outside click */
        document.addEventListener('click', e => {
            if (!navbar.contains(e.target) && navMenu.classList.contains('active')) {
                hamburger.classList.remove('active');
                navMenu.classList.remove('active');
                document.body.style.overflow = '';
            }
        });

        /* 5. Close on Escape */
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && navMenu.classList.contains('active')) {
                hamburger.classList.remove('active');
                navMenu.classList.remove('active');
                document.body.style.overflow = '';
            }
        });

        /* 6. Active link on scroll */
        const sections  = document.querySelectorAll('section[id]');
        const navLinks  = document.querySelectorAll('.nav-menu a');
        window.addEventListener('scroll', () => {
            let current = '';
            sections.forEach(section => {
                if (window.scrollY >= section.offsetTop - 200) {
                    current = section.getAttribute('id');
                }
            });
            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') === `#${current}`) {
                    link.classList.add('active');
                }
            });
        });

        /* ============================================
           FLASH SALE TIMER  (safe — null check)
           ============================================ */
        const hoursEl   = document.getElementById("hours");
        const minutesEl = document.getElementById("minutes");
        const secondsEl = document.getElementById("seconds");

        if (hoursEl && minutesEl && secondsEl) {
            let totalTime = 12 * 60 * 60; // 12 hours

            function updateTimer() {
                const h = Math.floor(totalTime / 3600);
                const m = Math.floor((totalTime % 3600) / 60);
                const s = totalTime % 60;

                hoursEl.innerText   = h < 10 ? "0" + h : h;
                minutesEl.innerText = m < 10 ? "0" + m : m;
                secondsEl.innerText = s < 10 ? "0" + s : s;

                if (totalTime > 0) totalTime--;
                else {
                    clearInterval(timer);
                    hoursEl.innerText = minutesEl.innerText = secondsEl.innerText = "00";
                }
            }

            updateTimer();
            const timer = setInterval(updateTimer, 1000);
        }
   // ajax script
        function showToast(message, ok) {
            var t = document.createElement('div');
            t.className = 'toast' + (ok ? '' : ' error');
            t.textContent = message;
            document.body.appendChild(t);
            requestAnimationFrame(function () { t.classList.add('show'); });
            setTimeout(function () {
                t.classList.remove('show');
                setTimeout(function () { t.remove(); }, 300);
            }, 2500);
        }

        document.addEventListener('submit', async function (e) {
            var form = e.target;
            if (!form.matches('form[action*="AddToCart"]')) return;

            e.preventDefault();
            var btn = form.querySelector('button[type=submit]');
            if (btn) btn.disabled = true;

            try {
                var res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                // login expire ho gaya ho to login page par bhej do
                if (res.redirected) {
                    window.location.href = res.url;
                    return;
                }

                var data = await res.json();
                showToast(data.message, data.success);

                if (data.success) {
                    var badge = document.getElementById('cartBadge');
                    if (badge) badge.textContent = data.cartCount;
                }
            } catch (err) {
                showToast('Kuch galat ho gaya, dobara try karo.', false);
            } finally {
                if (btn) btn.disabled = false;
            }
        });
    </script>
</body>
</html>