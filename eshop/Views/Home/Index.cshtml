        </div>

        <div class="why-card">
            <i class="fa-solid fa-credit-card"></i>
            <h3>Secure Payment</h3>
            <p>100% safe and encrypted payment methods.</p>
        </div>

        <div class="why-card">
            <i class="fa-solid fa-rotate-left"></i>
            <h3>Easy Returns</h3>
