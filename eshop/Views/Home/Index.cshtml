            <img src="/imgshop/woman-4.webp" alt="Fashion">
            <h3>Fashion</h3>
        </div>

        <div class="category-card">
            <img src="https://img.magnific.com/free-photo/two-beautiful-women-shopping-town_1303-16431.jpg?semt=ais_hybrid&w=740&q=80" alt="Beauty">
            <h3>Beauty</h3>
        </div>

        <div class="category-card">
            <img src="https://t3.ftcdn.net/jpg/01/40/97/08/360_F_140970862_ApYCTSWXUDpNbpQP4UgNyhnOXnuG4gY5.jpg" alt="Fashion">
            <h3>Fashion</h3>
        </div>

        <div class="category-card">
            <img src="https://media.istockphoto.com/id/863190232/photo/happy-girl-shopping-in-the-fashion-store.jpg?s=612x612&w=0&k=20&c=5JfvoWoOWXa5Zk4UTGQuAQ3ZWc_Bar3wnV0Tfec5hcU=" alt="Fashion">
            <h3>Fashion</h3>
        </div>

        <div class="category-card">
            <img src="https://media.istockphoto.com/id/2164807382/photo/making-the-best-of-the-day-together.jpg?s=612x612&w=0&k=20&c=ONB6q_9SXI4NOlfSwggNtbUYfJHdOIFvF-yuMNjJHD4=" alt="Bag">
            <h3>Bag</h3>
        </div>

        <div class="category-card">
            <img src="https://media.istockphoto.com/id/1277267181/photo/young-attractive-happy-couple-hugging-smiling-and-holding-shopping-bags-while-walking-in.jpg?s=612x612&w=0&k=20&c=rhalFXbDy8oVW7pGHa0gUfvrlsnFGTqeSiLmAQXbgVg=" alt="Fashion">
            <h3>Fashion</h3>
        </div>

        <div class="category-card">
            <img src="https://img.magnific.com/free-photo/black-friday-elements-assortment_23-2149074075.jpg?semt=ais_hybrid&w=740&q=80" alt="Bags">
            <h3>Bags</h3>
        </div>

        <div class="category-card">
            <img src="/imgshop/shirt-3.webp" alt="Fashion">
            <h3>Fashion</h3>
        </div>

        <div class="category-card">
            <img src="https://img.magnific.com/free-photo/black-friday-elements-assortment_23-2149074075.jpg?semt=ais_hybrid&w=740&q=80" alt="Bags">
            <h3>Bags</h3>
        </div>

        <div class="category-card">
            <img src="/imgshop/shirt-3.webp" alt="Fashion">
            <h3>Fashion</h3>
        </div>

    </div>

</section>

<!-- ================= FLASH SALE ================= -->
<section class="flash-sale" id="newarrival">

    <div class="flash-header">

        <div>
            <h2>🔥 Flash Sale</h2>
            <p>Limited Time Offers</p>
        </div>

        <div class="timer">
            <div class="time-box">
                <h3 id="hours">12</h3>
                <span>Hours</span>
            </div>
            <div class="time-box">
                <h3 id="minutes">30</h3>
                <span>Min</span>
            </div>
            <div class="time-box">
                <h3 id="seconds">45</h3>
                <span>Sec</span>
            </div>
        </div>

        <a class="explore-btn" asp-controller="Home" asp-fragment="featured" style="text-decoration:none">View All</a>
    </div>

    <div class="flash-products">
        @foreach (var p in Model.FlashProducts)
        {
            <div class="flash-card">
                @if (p.DiscountPercent > 0)
                {
                    <span class="discount">-@p.DiscountPercent%</span>
                }
                <a asp-controller="Home" asp-action="Details" asp-route-id="@p.Id" class="card-link">
                    <img src="@p.ImageUrl" alt="@p.Name">
                    <h3>@p.Name</h3>
                </a>
                <p class="price">₹@p.Price.ToString("N0") <del>₹@p.OldPrice.ToString("N0")</del></p>
                @if (p.SizeList.Any())
                {
                    <button type="button" class="add-cart-btn"
                            onclick="location.href='@Url.Action("Details", "Home", new { id = p.Id })'">
                        Select Size
                    </button>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Home" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@p.Id" />
                        <button type="submit" class="add-cart-btn">Add to Cart</button>
                    </form>
                }
                else
                {
                    <button type="button" class="add-cart-btn"
                            onclick="location.href='@Url.Action("Login", "Account")'">
                        Add to Cart
                    </button>
                }
            </div>
        }
    </div>
</section>

<!-- ================= FEATURED PRODUCTS ================= -->
<section class="featured" id="featured">

    <div class="title">
        <h2>⭐ Featured Products</h2>
        <p>Handpicked Products Just For You</p>
    </div>

    <div class="filter-btn">
        <button type="button" onclick="location.href='@Url.Action("Search", "Home")'">All</button>
        <button type="button" onclick="location.href='@Url.Action("Search", "Home", new { q = "Fashion" })'">Fashion</button>
        <button type="button" onclick="location.href='@Url.Action("Search", "Home", new { q = "Shoes" })'">Shoes</button>
    </div>

    <div class="product-container">
        @foreach (var p in Model.FeaturedProducts)
        {
            <div class="product-card">
                @if (p.DiscountPercent > 0)
                {
                    <span class="tag">-@p.DiscountPercent%</span>
                }
                <i class="fa-regular fa-heart heart"></i>
                <a asp-controller="Home" asp-action="Details" asp-route-id="@p.Id" class="card-link">
                    <img src="@p.ImageUrl" alt="@p.Name">
                    <h3>@p.Name</h3>
                </a>
                <div class="rating">★★★★★</div>
                <p class="price">₹@p.Price.ToString("N0") <del>₹@p.OldPrice.ToString("N0")</del></p>
                @if (p.SizeList.Any())
                {
                    <button type="button" class="add-cart-btn"
                            onclick="location.href='@Url.Action("Details", "Home", new { id = p.Id })'">
                        Select Size
                    </button>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Home" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@p.Id" />
                        <button type="submit" class="add-cart-btn">Add to Cart</button>
                    </form>
                }
                else
                {
                    <button type="button" class="add-cart-btn"
                            onclick="location.href='@Url.Action("Login", "Account")'">
                        Add to Cart
                    </button>
                }
            </div>
        }
    </div>

</section>

