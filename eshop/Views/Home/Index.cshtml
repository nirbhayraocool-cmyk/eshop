@model eshop.Models.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}
@if (TempData["Success"] != null)
{
    <div style="background:#d4edda;color:#155724;padding:12px;text-align:center;">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div style="background:#f8d7da;color:#721c24;padding:12px;text-align:center;">@TempData["Error"]</div>
}
<!--  HERO  -->
<section class="hero" id="home">
    <div class="hero-content">

        <span class="offer">🔥 Big Sale 2026</span>

        <h1>
            Discover Your <span>Perfect Style</span><br>
            With NextCart
        </h1>

        <p>
            Shop the latest fashion, electronics, accessories and more.
            Enjoy exclusive deals, fast delivery, secure payments and easy returns.
        </p>

        <div class="hero-btn" >
            <a class="shop-btn" asp-controller="Home" asp-fragment="featured" style="text-decoration:none">Shop Now</a>
            <a class="explore-btn" asp-controller="Home" asp-fragment="newarrival" style="text-decoration:none">Explore More</a>
        </div>

    </div>
</section>

<!-- ================= SHOP BY CATEGORY ================= -->
